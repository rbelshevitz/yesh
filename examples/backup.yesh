# Run from a working directory containing source/.
# Publish the archive only after every stage succeeds.
source = "source"
partial = "backup.tar.gz.partial"
archive = "backup.tar.gz"

if exists source:
    tar -cf - -- source | gzip > partial
    mv -- partial archive
    printf '%s\n' '{"schema":1,"status":"complete","archive":"backup.tar.gz"}' > "backup-state.json.partial"
    mv -- "backup-state.json.partial" "backup-state.json"
else:
    echo "source directory is missing"
    exit 1
