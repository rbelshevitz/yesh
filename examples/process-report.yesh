# Environment-dependent example: reports processes visible in this Linux host.
# Show a bounded process report without killing or modifying processes.
ps -eo pid=,ppid=,user=,rss=,stat=,comm= | head -n 25

services = [sshd, nginx]
for service in $services:
    if pgrep -x $service:
        echo $service "is running"
    else:
        echo $service "is not running"
