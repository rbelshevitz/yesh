# Copy into an existing local directory. Extra files are not deleted.
# The exists check does not replace checking that the backup device is mounted.
source = "source/"
target = "target/"
if exists target:
    if findmnt --target target:
        findmnt --target target
        df -P -h -- target
        rsync -a --itemize-changes -- source target
    else:
        echo "target is not on a mounted filesystem"
        exit 3
else:
    echo "target directory is missing"
    exit 2
