# Goal: copy a source tree into an existing local directory.
# Inputs: `source/` is the source tree; `target/` must exist and be mounted.
# Change: rsync copies files into the target; extra target files are not deleted.
# Failure: a missing or unmounted target stops before rsync; rsync errors remain visible.
# Boundary: `exists` checks the path only; it does not prove that the backup device is mounted.
# Role of yesh: guard inputs, ordering, and publication boundaries; rsync remains the transfer engine.

source = "source/"
target = "target/"
if exists $target:
    if findmnt --target $target:
        findmnt --target $target
        df -P -h -- $target
        rsync -a --itemize-changes -- $source $target
    else:
        echo "target is not on a mounted filesystem"
        exit 3
else:
    echo "target directory is missing"
    exit 2
