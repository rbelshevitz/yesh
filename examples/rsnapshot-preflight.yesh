# Safe rsnapshot preflight. This does not rotate snapshots or modify data.
# Keep the normal rsnapshot.conf as the source of truth; yesh only makes the
# reviewable order explicit: syntax check, then rsnapshot test mode.
#
# Required environment:
#   YESH_RSNAPSHOT_CONFIG  path to the prepared rsnapshot.conf
#   YESH_RSNAPSHOT_LEVEL   interval to preview, for example daily
#
# The config must set snapshot_root, lockfile and (for removable media)
# no_create_root=1. Remote sources remain ordinary rsnapshot backup entries;
# SSH authentication and known_hosts come from the normal OpenSSH setup.
config = environment YESH_RSNAPSHOT_CONFIG
level = environment YESH_RSNAPSHOT_LEVEL

rsnapshot -c $config configtest
rsnapshot -c $config -t $level
