# Destination inventory for this rsync workflow; this example only reads.
# IMPORTANT: run this on the backup host. The backup host is the rsync
# destination, so root is local here even when source is remote.
# This is not a push-to-another-server workflow.
# No external rsync, retention apply, rename, or deletion is performed.
#
# YESH_RSYNC_ROOT  existing local destination directory on this host
# YESH_RSYNC_KEEP  number of newest completed snapshots to keep

# Role of yesh: guard inputs, ordering, and publication boundaries; rsync remains the transfer engine.
root = environment YESH_RSYNC_ROOT
keep = environment YESH_RSYNC_KEEP

if exists $root:
    if findmnt --target $root:
        findmnt --target $root
        stat -c "type=%F mode=%a owner=%U:%G" -- $root
        df -P -h -- $root
        rsync retention plan in $root keep $keep
    else:
        echo "backup destination is not on a mounted filesystem"
        exit 2
else:
    echo "backup destination is missing"
    exit 2
