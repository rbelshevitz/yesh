# A finite, read-only resource measurement for an existing nginx service.
# The explicit temporary directory makes the saved history easy to inspect
# and remove after the exercise.
# It contains measurements.jsonl and its lock file; summarize reads that
# history. Use ~/.local/yesh/nginx.service.jsonl for regular operation.
# If `save to` is omitted, yesh uses that default user-owned directory and
# never invokes sudo. An explicit state path must be writable by this user.
#
# Run with --plan first. nginx must already exist and be readable by the system
# manager. Replace it only with another exact service meaningful on the host.
# yesh does not start nginx or create HTTP traffic; provide load separately.

# The retention directive keeps a 24-hour sliding history for nginx.
state_dir = "/tmp/yesh-nginx-resources"
service status nginx.service
measure service nginx.service for 30s every 5s:
    save to $state_dir
    keep history for 24h
summarize service nginx.service from $state_dir since 1h
journal nginx.service since 15m lines 40
