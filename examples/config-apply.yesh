# Demonstration of one parameter check, not a universal validator.
# A real service should use its own configuration validator here.

staged = "staged.conf"
active = "active.conf"
next = "active.conf.next"

if grep -q '^mode=production$' $staged:
    install -m 0640 -- $staged $next
    mv -- $next $active
    echo "configuration applied"
else:
    echo "configuration check failed"
    exit 3
