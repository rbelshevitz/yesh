# Демонстрационная проверка одного параметра, не универсальный валидатор.
# Для реальной службы здесь должна быть её штатная проверка конфигурации.
staged = "staged.conf"
active = "active.conf"
next = "active.conf.next"

if grep -q '^mode=production$' staged:
    install -m 0640 -- staged next
    mv -- next active
    echo "конфигурация применена"
else:
    echo "проверка конфигурации не пройдена"
    exit 3
