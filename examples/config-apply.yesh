# Goal: validate one setting, then publish the configuration only after success.
# Inputs: `staged.conf` is the candidate; `active.conf` is the published file.
# Change: a valid candidate replaces `active.conf` through `active.conf.next`.
# Failure: an invalid candidate returns 3 and leaves the active file unchanged.
# Boundary: this is one parameter check, not a complete service validator.

# Role of yesh: make validation, publication order, and refusal visible; the external validator or service remains authoritative.
staged = "staged.conf"
active = "active.conf"
next = "active.conf.next"

if grep -q '^mode=production$' $staged:
    install -m 0640 -- $staged $next
    mv -- $next $active
    echo "configuration applied"
else:
    echo "configuration check failed"
    exit 3
