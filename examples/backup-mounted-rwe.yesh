# RWE: copy a source directory only to the expected mounted filesystem.
# Inputs: YESH_RWE_MOUNTPOINT, YESH_RWE_SOURCE (UUID/PARTUUID),
# YESH_RWE_SOURCE_DIR, and YESH_RWE_TARGET. The fixture supplies a disposable
# ext4 mount and writable target; production mounts are not changed here.
# Order: verify source, filesystem type, and read-write mount, then source and
# target, then free space,
# then run the visible rsync. No rsync argv is hidden in a shell wrapper.
# Results: 0 means rsync completed; 2 means a path is missing, 3 means the
# filesystem identity check failed, and 4 means the 20 MiB floor was not met.
# A failed preflight must leave the target untouched; verify that with `--plan`
# and the negative fixture cases.
# Role of yesh: guard inputs, ordering, and publication boundaries; rsync remains the transfer engine.

mountpoint = environment YESH_RWE_MOUNTPOINT
expected_source = environment YESH_RWE_SOURCE
source = environment YESH_RWE_SOURCE_DIR
target = environment YESH_RWE_TARGET

if findmnt --kernel --source $expected_source --target $mountpoint --types ext4 --options rw:
    findmnt --kernel --source $expected_source --target $mountpoint
else:
    echo "backup filesystem identity does not match"
    exit 3

if exists $source:
    if exists $target:
        if free_space $target at_least 20MiB:
            rsync -a --itemize-changes -- $source $target
        else:
            echo "not enough free space"
            exit 4
    else:
        echo "backup target is missing"
        exit 2
else:
    echo "backup source is missing"
    exit 2
