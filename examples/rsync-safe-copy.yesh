# Environment-dependent example: requires a mounted target and YESH_BACKUP_SOURCE.
# Copy a backup only to the expected filesystem.
# Set YESH_BACKUP_SOURCE to a verified UUID=... or PARTUUID=... value.

source = "source/"
target = "target/"
mountpoint = $target
expected_source = environment YESH_BACKUP_SOURCE

if exists $source:
    if exists $target:
        if findmnt --source $expected_source --target $mountpoint:
            findmnt --source $expected_source --target $mountpoint
            df -P -h -- $mountpoint
            if free_space $mountpoint at_least 20MiB:
                rsync -a --itemize-changes -- $source $target
            else:
                echo "not enough free space"
                exit 4
        else:
            echo "target filesystem identity does not match"
            exit 3
    else:
        echo "target directory is missing"
        exit 2
else:
    echo "source directory is missing"
    exit 2
