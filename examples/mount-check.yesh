# Environment-dependent example: replace /backup with a mounted path.
# Verify that the expected backup mount is present.
# This is a read-only check; it does not mount or unmount anything.
# Role of yesh: make the read-only preflight and refusal path explicit; Linux storage tools provide the state.

mountpoint = /backup

if findmnt --target $mountpoint:
    findmnt --target $mountpoint
    df -h -- $mountpoint
else:
    echo "backup mount is missing"
    exit 2
