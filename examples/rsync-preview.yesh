# Goal: show proposed rsync changes without modifying source or destination.
# Inputs: `source/` is the source tree; `target/` must already exist. `findmnt`
# reports the filesystem containing it; use a storage identity preflight for
# one exact backup device.
# Change: none; `--dry-run` asks rsync for a preview only.
# Failure: a missing target or failed filesystem lookup stops before rsync;
# rsync errors remain visible. Boundary: this does not prove a particular
# backup device, full contents, or future write access.
# Role of yesh: guard inputs, ordering, and publication boundaries; rsync remains the transfer engine.

source = "source/"
target = "target/"

if exists $target:
    if findmnt --target $target:
        findmnt --target $target
        df -P -h -- $target
        rsync -a --dry-run --itemize-changes -- $source $target
    else:
        echo "target is not on a mounted filesystem"
        exit 3
else:
    echo "target directory is missing"
    exit 2
