# Require the backup path to be mounted from one exact filesystem identity.
# Use either UUID=... or PARTUUID=...; this script never mounts anything.
mountpoint = /backup
expected_source = "UUID=replace-with-the-real-uuid"

if findmnt --source expected_source --target mountpoint:
    findmnt --source expected_source --target mountpoint
    echo "backup filesystem identity is correct"
else:
    echo "backup filesystem identity does not match"
    exit 3
