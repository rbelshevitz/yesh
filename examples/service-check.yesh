# Environment-dependent example: requires systemd access and nginx/sshd units.
# Check access to systemd, then confirm each service is active.
# Replace the service names with units installed on your machine.
# Role of yesh: keep the service or journal request bounded and visible; systemd remains the source of state.

services = [nginx, sshd]

systemctl show --property=Version > /dev/null

for service in $services:
    if systemctl is-active --quiet -- $service:
        echo $service "is active"
    else:
        echo $service "active check failed"
        exit 1
