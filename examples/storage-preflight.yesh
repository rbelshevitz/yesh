# Environment-dependent example: replace the UUID and provide the matching mount.
# Read-only Linux preflight: replace the UUID before running this example.
# The directory must itself be mounted from this unique device as ext4.
# Role of yesh: make the read-only preflight and refusal path explicit; Linux storage tools provide the state.

backup = device by uuid "replace-with-real-uuid"
inspect $backup
require mounted /mnt/backup from $backup filesystem "ext4" writable
echo "backup mount identity preflight passed"
