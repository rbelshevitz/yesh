# Environment-dependent example: requires SSH access to web-1 and rsync.
# Replace the host, paths, and service name before running.
# Minimal deployment example.

host = web-1
release = build/current/
# The address is one complete value: there is no substitution inside host:path.
target = web-1:/srv/app/

echo "deploying" $release "to" $host
rsync -az $release $target
ssh $host systemctl restart api

if ssh $host systemctl is-active api:
    echo "deploy complete"
else:
    echo "deploy failed"
    exit 1
