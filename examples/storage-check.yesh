# Environment-dependent example: replace /backup with an existing mounted path.
# Read-only storage preflight for a backup destination.
# The check does not mount, unmount, delete, or modify anything.

# Role of yesh: make the read-only preflight and refusal path explicit; Linux storage tools provide the state.
mountpoint = /backup

if findmnt --target $mountpoint:
    findmnt --target $mountpoint
    df -P -h -- $mountpoint
    du -x -d 1 -h -- $mountpoint
else:
    echo "backup mount is missing"
    exit 2
