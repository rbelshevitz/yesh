# Environment-dependent example: replace web-1/web-2 and provide SSH trust/credentials.
# Check hosts through the user's normal SSH config or agent.
# No private keys or passwords are stored in this script.
# Role of yesh: keep remote arguments, checks, and failure boundaries visible; SSH or rsync performs the remote operation.

port = 22
ssh_options = [-p, $port, -o, BatchMode=yes, -o, ConnectTimeout=5, -o, StrictHostKeyChecking=yes]
hosts = [web-1, web-2]

for host in $hosts:
    if ssh $ssh_options $host hostname:
        ssh $ssh_options $host uptime
    else:
        echo $host "health check failed"
        exit 1
